diff --git a/alfworld_action_normalize.py b/alfworld_action_normalize.py
new file mode 100644
--- /dev/null
+++ b/alfworld_action_normalize.py
@@ -0,0 +1,22 @@
+"""Compatibility adapter for the ALFWorld data release used by AE3."""
+
+import re
+
+
+_PUT_RE = re.compile(
+    r"put\s+(.+?)\s+(?:in/on|in|on)\s+(.+)",
+    flags=re.IGNORECASE,
+)
+
+
+def normalize_alfworld_action(action):
+    """Rewrite legacy placement syntax to this environment's command syntax."""
+    if action is None:
+        return None
+    raw_action = action.strip()
+    match = _PUT_RE.fullmatch(raw_action)
+    if not match:
+        return raw_action
+    obj = match.group(1).strip()
+    receptacle = match.group(2).strip()
+    return f"move {obj} to {receptacle}"
diff --git a/test_alfworld_action_normalize.py b/test_alfworld_action_normalize.py
new file mode 100644
--- /dev/null
+++ b/test_alfworld_action_normalize.py
@@ -0,0 +1,35 @@
+from alfworld_action_normalize import normalize_alfworld_action
+
+
+def test_put_variants_convert():
+    assert normalize_alfworld_action(
+        "put saltshaker 1 in/on drawer 2"
+    ) == "move saltshaker 1 to drawer 2"
+    assert normalize_alfworld_action(
+        "put mug 12 in coffeemachine 3"
+    ) == "move mug 12 to coffeemachine 3"
+    assert normalize_alfworld_action(
+        "PUT pan 2 ON countertop 1"
+    ) == "move pan 2 to countertop 1"
+
+
+def test_non_put_and_malformed_actions_pass_through():
+    for action in (
+        "move mug 1 to fridge 1",
+        "take mug 1 from countertop 1",
+        "cool mug 1 with fridge 1",
+        "put mug 1",
+        "think: I should put the mug in the fridge.",
+    ):
+        assert normalize_alfworld_action(action) == action
+
+
+def test_none_is_safe():
+    assert normalize_alfworld_action(None) is None
+
+
+if __name__ == "__main__":
+    test_put_variants_convert()
+    test_non_put_and_malformed_actions_pass_through()
+    test_none_is_safe()
+    print("3 tests passed")
